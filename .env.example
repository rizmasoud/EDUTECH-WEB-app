# ==============================================================================
# EduTech Web - Environment Configuration (Example Template)
# ==============================================================================
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO SOURCE CONTROL.
# Copy this file to .env or .env.local for your local development configuration.

# Application Environment
NODE_ENV=development

# Backend API Configuration (NestJS)
API_PORT=4000
API_PREFIX=

# Database
# Choose the driver EXPLICITLY. A failed PostgreSQL connection never switches to PGlite.
#   DATABASE_DRIVER=postgres  -> needs a postgres:// or postgresql:// DATABASE_URL
#   DATABASE_DRIVER=pglite    -> embedded database, non-production only; leave DATABASE_URL unset
# Invalid or conflicting combinations fail at startup with a clear message.
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://edutech_user:edutech_password@localhost:5432/edutech_db

# PostgreSQL (Local Docker Compose)
POSTGRES_USER=edutech_user
POSTGRES_PASSWORD=edutech_password
POSTGRES_DB=edutech_db
POSTGRES_PORT=5432

# PGlite development options (only used when DATABASE_DRIVER=pglite). All default to off.
#   PGLITE_DATA_DIR       directory for the embedded database ("memory" = in-memory). Default: ./.pglite-storage
#   PGLITE_AUTO_MIGRATE   true = replay every SQL migration at startup (untracked, dev only). Default: false
#   PGLITE_SEED_DEMO      true = insert demo accounts/data if the accounts table is empty. Default: false
# The embedded database is never deleted or reset automatically.
# PGLITE_DATA_DIR=
# PGLITE_AUTO_MIGRATE=false
# PGLITE_SEED_DEMO=false

# Frontend Configuration (Next.js)
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Platform Environment Variables (Managed by AI Studio / Cloud Run)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
