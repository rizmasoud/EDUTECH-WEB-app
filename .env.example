# ==============================================================================
# EduTech Web - Environment Configuration (Example Template)
# ==============================================================================
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO SOURCE CONTROL.
# Copy this file to .env or .env.local for your local development configuration.

# Application Environment
NODE_ENV=development

# Backend API Configuration (NestJS)
API_PORT=4000
API_PREFIX=

# Database: PostgreSQL is the only supported runtime database.
# There is NO fallback engine: if DATABASE_URL is missing or unreachable the API refuses to start
# with an actionable error. The values below are LOCAL DEVELOPMENT PLACEHOLDERS (never real credentials).
# The API, `pnpm db:*` scripts and docker compose all read this same .env file.
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://edutech_user:edutech_password@127.0.0.1:5432/edutech_db
# Seconds the API waits for PostgreSQL to accept connections at startup (default 30, 0 = do not wait).
# DATABASE_CONNECT_RETRY_SECONDS=30

# PostgreSQL (local Docker Compose service "postgres"; keep in sync with DATABASE_URL above)
POSTGRES_USER=edutech_user
POSTGRES_PASSWORD=edutech_password
POSTGRES_DB=edutech_db
POSTGRES_PORT=5432

# Frontend Configuration (Next.js)
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Platform Environment Variables (Managed by AI Studio / Cloud Run)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
