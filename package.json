{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"cyan,magenta\" \"tsx --tsconfig apps/api/tsconfig.json apps/api/src/main.ts\" \"next dev -p 3000\"",
    "build": "next build",
    "build:shared": "pnpm --filter @edutech/shared build",
    "build:api": "pnpm --filter @edutech/shared build && pnpm --filter @edutech/api build",
    "start": "next start",
    "test": "tsx --tsconfig apps/api/tsconfig.json --test tests/unit/*.spec.ts tests/integration/*.spec.ts",
    "test:coverage": "tsx --tsconfig apps/api/tsconfig.json --test --experimental-test-coverage tests/unit/*.spec.ts tests/integration/*.spec.ts",
    "lint": "eslint .",
    "clean": "next clean"
  },
  "dependencies": {
    "@edutech/shared": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@types/multer": "^2.3.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "drizzle-orm": "^0.39.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "postgres": "^3.4.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.30.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "prettier": "^3.9.8",
    "tailwindcss": "4.1.11",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
